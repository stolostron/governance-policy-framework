{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "America/New_York",
  "schedule": [
    "* * 1-7 * 0"
  ],
  "commitMessageSuffix": "({{{baseBranch}}})",
  "updateNotScheduled": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["* * * * 0"],
    "minimumReleaseAge": "3 days",
    "groupName": "{{manager}} security updates",
    "groupSlug": "{{manager}}-security",
    "labels": ["acknowledge-security-fixes-only"],
    "commitMessageSuffix": "[SECURITY] ({{{baseBranch}}})"
  },
  "dockerfile": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "schedule": ["* * 1-7 * 0"]
  },
  "rpm-lockfile": {
    "lockFileMaintenance": {
      "schedule": ["* * 1-7 * 0"]
    }
  },
  "gomod": {
    "packageRules": [
      {
        "matchDepTypes": ["indirect"],
        "enabled": false
      }
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "enabled": false,
      "vulnerabilityAlerts": {
        "enabled": true
      },
      "osvVulnerabilityAlerts": true
    },
    {
      "matchManagers": ["git-submodules"],
      "groupName": "Git submodules"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub actions",
      "pinDigests": true,
      "separateMajorMinor": false
    }
  ]
}
